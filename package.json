{
  "name": "iotank-fuel-intelligence-hub",
  "version": "2.0.0",
  "description": "Cloud-native Industrial IoT fuel tank monitoring dashboard with AI analytics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:admin": "npm run dev --prefix \"super Admin\"",
    "build:admin": "npm run build --prefix \"super Admin\"",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:integration:edge": "jest __tests__/edge-runtime.integration.test.js --runInBand",
    "test:all": "npm run test && npm run test:integration:edge",
    "test:e2e": "cypress open",
    "pre-deploy": "npm run type-check && npm run test && npm run build",
    "deploy:client": "firebase deploy --only hosting:the-iotank-project",
    "deploy:client:prod": "npm run pre-deploy && npm run deploy:client",
    "pre-deploy:admin": "npm run --prefix \"super Admin\" type-check && npm run build:admin",
    "deploy:admin": "firebase deploy --only hosting:the-admin-iotank",
    "deploy:admin:prod": "npm run pre-deploy:admin && npm run deploy:admin",
    "deploy:all": "npm run build && npm run build:admin && firebase deploy --only hosting",
    "deploy:all:prod": "npm run pre-deploy && npm run pre-deploy:admin && npm run deploy:all",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db seed"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@react-three/drei": "^9.92.5",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "chart.js": "^4.4.0",
    "classnames": "^2.3.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.0.0",
    "i18next": "^23.7.8",
    "intro.js": "^7.2.0",
    "intro.js-react": "^1.0.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-grid-layout": "^1.4.4",
    "react-i18next": "^13.5.0",
    "react-icons": "^4.12.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "three": "^0.159.0",
    "vite-plugin-compression": "^0.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-grid-layout": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^4.2.1",
    "cypress": "^13.6.2",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.0.5",
    "source-map-explorer": "^2.5.3",
    "supabase": "^2.84.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "@tootallnate/once": "2.1.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
