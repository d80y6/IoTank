# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Security Features
VITE_RECAPTCHA_V3_SITEKEY=your_recaptcha_site_key_here
# Master access passphrase for the admin governance console. Keep long + random.
VITE_MASTER_ACCESS_PASSWORD=your_master_access_password_here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Realtime (set to "true" to DISABLE realtime subscriptions)
VITE_DISABLE_REALTIME=false

# Payments (Paystack) — public key is bundle-safe; secret key should only be
# used server-side (Supabase Edge Functions), never shipped to the browser.
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
VITE_PAYSTACK_SECRET_KEY=

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Jurisdiction: default region code when none is set by the station (e.g. GLOBAL, KE)
VITE_JURISDICTION=GLOBAL

# App Configuration
VITE_APP_NAME=IoTank Fuel Intelligence Hub
VITE_APP_VERSION=2.0.0
VITE_DEFAULT_LOCALE=en
VITE_ENABLE_ANALYTICS=true

# Feature Flags
VITE_ENABLE_3D_MODELS=true
VITE_ENABLE_AR_MODE=false
VITE_ENABLE_VOICE_CONTROL=false
VITE_ENABLE_COLLABORATION=true
VITE_ENABLE_DEBUG_TOOLS=false
VITE_ENABLE_GOVERNANCE_CONSOLE=true